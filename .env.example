# Copy to .env and uncomment what you want to change. Compose reads this file
# from the directory holding compose.yaml. All values shown are the defaults.

# Number of Tor clients (1-1000). Budget roughly 60 MB RAM each.
#TORS=10

# Seconds between circuit rotations.
#ROTATE_INTERVAL=600

# Where to publish the ports on the host. Keep loopback unless the proxy sits
# behind a firewall or VPN.
#BIND_ADDRESS=127.0.0.1
#SOCKS_PORT=9050
#STATS_PORT=4444

# Enable the HAProxy stats page: point this at a file containing one line,
# "user:password" (password 12-256 characters). For example:
#   mkdir -m 700 secrets && printf 'admin:%s\n' "$(openssl rand -base64 24)" > secrets/stats_auth
#STATS_AUTH_SECRET=./secrets/stats_auth

# Optional end-to-end health check: a hostname resolved through each Tor
# client at every rotation. Unset keeps all checks local and traffic-free.
#TEST_HOST=check.torproject.org

# Log every client connection through HAProxy (records client addresses).
#LOG_CONNECTIONS=false

# Concurrent connections allowed per client address. Unset means unlimited.
#MAX_CONNS_PER_SOURCE=50

# Extra Tor options for every client, shell-quoted.
#TOR_EXTRA_ARGS=--ExitNodes {us} --StrictNodes 1

# Supervisor verbosity: debug, info, warn, error.
#LOG_LEVEL=info
